<Window x:Class="TruvaDesktop.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uygulama Seç" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1A1C2E" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Uygulama Seçme Paneli" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Text="VPN tüneline dahil etmek istediğiniz .exe dosyasını seçin." Foreground="#8E9AAF" FontSize="12" Margin="0,0,0,15"/>

        <!-- Search Box -->
        <Border Background="#1E1E1E" CornerRadius="5" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#888" Margin="5,0,0,0"/>
                <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="5,8" FontSize="13" 
                         VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" Tag="Uygulama ara..."/>
            </Grid>
        </Border>
        
        <Border Grid.Row="1" Background="#242745" CornerRadius="10" Padding="5">
            <Grid>
                <ListBox x:Name="lstInstalledApps" Background="Transparent" Foreground="White" 
                          BorderThickness="0" Visibility="Collapsed"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="LstInstalledApps_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,8">
                                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,15,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding ExeName}" Foreground="#888888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Loading Overlay -->
                <StackPanel x:Name="loadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="40" Foreground="#00E5FF" Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="Uygulamalar Taranıyor..." Foreground="#8E9AAF" FontSize="14" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Lütfen bekleyin..." Foreground="#555" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button x:Name="btnFileBrowse" Content="Manuel .exe Seç..." Width="120" Height="35" HorizontalAlignment="Left" Background="#2D2D2D" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnFileBrowse_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="İptal" Width="80" Height="35" Margin="0,0,10,0" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
                <Button x:Name="btnAdd" Content="Listeye Ekle" Width="100" Height="35" Background="#00E5FF" Foreground="#121420" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
