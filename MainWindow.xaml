<Window x:Class="TruvaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truva" Height="600" Width="720"
        Icon="Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Custom ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Grid.ColumnSpan="2" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Border" Background="Transparent" BorderThickness="0">
                                                    <Path x:Name="Arrow" Fill="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" Background="#1A1C2E" BorderThickness="1" BorderBrush="#3D3F5A" CornerRadius="8" Margin="0,2,0,5" Padding="2">
                                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242745"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1A1C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer Margin="0" Focusable="false">
                                <StackPanel IsItemsHost="true"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1C2E"/>
                                <Setter Property="Foreground" Value="#8E9AAF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1A1C2E" CornerRadius="12" BorderBrush="#3D3F5A" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Nav Bar -->
                <RowDefinition Height="*"/>  <!-- Content Area -->
                <RowDefinition Height="85"/> <!-- Bottom Status Area -->
            </Grid.RowDefinitions>

            <!-- Nav Bar -->
            <Border Grid.Row="0" Background="#121420" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Image Source="Assets/logo.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="TRUVA" Foreground="#00E5FF" FontSize="18" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,30,0"/>

                        <RadioButton x:Name="navConn" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="BAĞLANTI" Foreground="White" FontWeight="SemiBold" IsChecked="True" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navApps" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="UYGULAMALAR" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navSafety" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="GÜVENLİK" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="btnPremium" Content="PREMIUM SATIN AL" Background="#FFD700" Foreground="#000" FontWeight="Black" 
                                FontSize="10" Padding="15,5" Margin="0,0,15,0" Cursor="Hand" Click="BtnPremium_Click" Visibility="Visible">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="—" Width="35" Height="35" Background="Transparent" Foreground="#888" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand"/>
                        <Button Content="✕" Width="35" Height="35" Background="Transparent" Foreground="#888" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="25">
                <!-- Section: Connection -->
                <Grid x:Name="paneConn" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sistem Geneli Bağlantı" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Tüm bilgisayarı VPN tüneline alarak tam koruma sağlar." Foreground="#8E9AAF" Margin="0,0,0,25"/>

                        <Border Background="#242745" CornerRadius="10" Padding="20,20,20,30" Margin="0,0,0,20" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="Sunucu Seçimi" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <ComboBox x:Name="cmbServers" DisplayMemberPath="DisplayName" Height="40" Padding="10,0,70,0" SelectionChanged="CmbServers_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,35,0" VerticalAlignment="Center">
                                        <Button x:Name="btnRefresh" Width="28" Height="28" Background="Transparent" BorderThickness="0" Click="BtnRefresh_Click" Cursor="Hand" ToolTip="Yenile">
                                            <TextBlock Text="🔄" Foreground="#00E5FF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="btnFavorite" Width="28" Height="28" Background="Transparent" BorderThickness="0" Click="BtnFavorite_Click" Cursor="Hand" ToolTip="Favori">
                                            <TextBlock Text="⭐" Foreground="#FFD700" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="toggleGameMode" Content="🕹️ Sadece Oyun Sunucuları (UDP)" Foreground="#8E9AAF" Margin="0,15,0,0" Checked="ToggleGameMode_Changed" Unchecked="ToggleGameMode_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                        <Button x:Name="btnConnectSystem" Width="200" Height="60" Click="BtnConnectSystem_Click" Background="#00E5FF" Foreground="#121420" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnSysText" Text="SİSTEME BAĞLA" FontWeight="Black" FontSize="14"/>
                        </Button>
                        <TextBlock Text="Tüm trafik VPN üzerinden geçer." Foreground="#8E9AAF" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Apps -->
                <Grid x:Name="paneApps" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Uygulama Tüneli" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Sadece seçtiğiniz uygulamalar VPN üzerinden internete erişir." Foreground="#8E9AAF" Margin="0,0,0,-5"/>

                        <Border Background="#242745" CornerRadius="10" Padding="12" Margin="0,15,0,10" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="VPN Listesine Eklenenler" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox x:Name="lstApps" Grid.Row="1" Background="#1A1C2E" Foreground="White" BorderThickness="0" SelectionMode="Extended" KeyDown="LstApps_KeyDown" Height="175"/>
                                
                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <Button x:Name="btnClearApps" Content="Listeyi Temizle" HorizontalAlignment="Left" Background="Transparent" Foreground="#DC3545" BorderThickness="0" Cursor="Hand" Click="BtnClearApps_Click" Padding="0"/>
                                    <Button x:Name="btnBrowseApp" Content="+ Uygulama Ekle" HorizontalAlignment="Right" Width="100" Height="25" Background="#242745" BorderBrush="#3D3F5A" BorderThickness="1" Foreground="White" Click="BtnBrowseApp_Click" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="#242745" CornerRadius="10" Padding="12,12,12,25" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="Uygulama İçin Sunucu Seç" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbServersApps" DisplayMemberPath="DisplayName" Height="38" SelectionChanged="CmbServersApps_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                        <Button x:Name="btnConnectApp" Width="200" Height="60" Click="BtnConnectApp_Click" Background="#00D2FF" Foreground="#121420" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnAppText" Text="UYG. İLE BAĞLA" FontWeight="Black" FontSize="14"/>
                        </Button>
                        <TextBlock Text="Sadece seçili uygulamalar etkilenir." Foreground="#8E9AAF" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Safety -->
                <Grid x:Name="paneSafety" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Dijital Kimlik Koruması" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Bilgisayarınızın bölge, saat ve donanım kimliklerini gizleyin." Foreground="#8E9AAF" Margin="0,0,0,25"/>

                        <Border Background="#242745" CornerRadius="10" Padding="20,20,20,30" ClipToBounds="True">
                            <StackPanel>
                                <CheckBox x:Name="toggleSpoofing" Content="🛡️ Kimlik Gizlemeyi Aktif Et" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" Checked="ToggleSpoofing_Changed" Unchecked="ToggleSpoofing_Changed"/>
                                <TextBlock Text="Hedef Taklit Bölgesi" Foreground="#00E5FF" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbSpoofingCountry" DisplayMemberPath="DisplayName" Height="38" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Premium Lock Overlay -->
            <Grid x:Name="premiumLockOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#CC121420" Visibility="Collapsed">
                <Border Background="#1A1C2E" CornerRadius="15" BorderBrush="#FFD700" BorderThickness="1" 
                        Width="450" Height="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Margin="30">
                        <TextBlock Text="👑" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="TRUVA PREMIUM GEREKLİ" Foreground="#FFD700" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Bu uygulamayı kullanmak için aktif bir aboneliğiniz olmalıdır. Premium ile şunlara sahip olursunuz:" 
                                   Foreground="#8E9AAF" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Margin="0,0,0,20"/>
                        
                        <StackPanel Margin="20,0,0,20">
                            <TextBlock Text="• Tüm Dünyadan Işık Hızında Sunucular" Foreground="White" FontSize="12" Margin="0,5"/>
                            <TextBlock Text="• Tam Gizlilik ve Kimlik Değiştirme" Foreground="White" FontSize="12" Margin="0,5"/>
                            <TextBlock Text="• Reklamsız ve Kayıtsız Deneyim" Foreground="White" FontSize="12" Margin="0,5"/>
                        </StackPanel>

                        <Button Content="HEMEN ABONE OL" Background="#FFD700" Foreground="Black" FontWeight="Black" 
                                Height="45" Cursor="Hand" Click="BtnPremium_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Area -->
            <Border Grid.Row="2" Background="#121420" BorderBrush="#3D3F5A" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="VPN DURUMU" Foreground="#8E9AAF" FontSize="10" FontWeight="Bold"/>
                            <Border x:Name="badgePremium" Background="#FFD700" CornerRadius="3" Margin="8,-2,0,0" Padding="5,1" Visibility="Collapsed">
                                <TextBlock Text="PREMIUM" Foreground="Black" FontSize="8" FontWeight="Black" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="txtStatus" Text="Bağlantı Bekleniyor" Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#242745" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTimer" Text="00:00:00" Foreground="White" FontFamily="Consolas" FontSize="14"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
