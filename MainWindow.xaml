<Window x:Class="TruvaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truva" Height="720" Width="950"
        Icon="Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Custom ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Grid.ColumnSpan="2" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Border" Background="Transparent" BorderThickness="0">
                                                    <Path x:Name="Arrow" Fill="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" Background="#1A1C2E" BorderThickness="1" BorderBrush="#3D3F5A" CornerRadius="8" Margin="0,2,0,5" Padding="2">
                                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1A1C2E"/>
            <Setter Property="BorderBrush" Value="#3D3F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer Margin="0" Focusable="false">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1C2E"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242745"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8E9AAF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1C2E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2D3050"/>
                                <Setter Property="Foreground" Value="#8E9AAF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1A1C2E" CornerRadius="12" BorderBrush="#3D3F5A" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/> <!-- Nav Bar -->
                <RowDefinition Height="*"/>  <!-- Content Area -->
                <RowDefinition Height="85"/> <!-- Bottom Status Area -->
            </Grid.RowDefinitions>

            <!-- Nav Bar -->
            <Border Grid.Row="0" Background="#121420" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo -->
                        <ColumnDefinition Width="*"/>    <!-- Navigation buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- Action buttons & Window controls -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,20,0">
                        <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"/>
                        <TextBlock Text="TRUVA" Foreground="#00E5FF" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <RadioButton x:Name="navConn" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="{DynamicResource NavConnection}" Foreground="White" FontWeight="SemiBold" IsChecked="True" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navGame" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="{DynamicResource NavGame}" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navNitro" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="{DynamicResource NavNitro}" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navApps" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="{DynamicResource NavApps}" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                        <RadioButton x:Name="navSafety" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" 
                                     Content="{DynamicResource NavSafety}" Foreground="White" FontWeight="SemiBold" 
                                     Padding="15,10" Cursor="Hand" Click="Nav_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="btnLang" Content="TR/EN" Background="#242745" Foreground="#00E5FF" FontWeight="Bold" 
                                FontSize="11" Padding="10,6" Margin="0,0,15,0" Cursor="Hand" Click="BtnLang_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#3D3F5A" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="—" Width="40" Height="40" Background="Transparent" Foreground="#888" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand" FontSize="16"/>
                        <Button Content="✕" Width="40" Height="40" Background="Transparent" Foreground="#888" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="30">
                <!-- Section: Connection -->
                <Grid x:Name="paneConn" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource TitleSystemConn}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource DescSystemConn}" Foreground="#8E9AAF" FontSize="14" Margin="0,0,0,30"/>

                        <Border Background="#242745" CornerRadius="12" Padding="25" Margin="0,0,0,25" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource HeaderServerSelect}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <ComboBox x:Name="cmbServers" DisplayMemberPath="DisplayName" Height="45" Padding="15,0,80,0" SelectionChanged="CmbServers_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,40,0" VerticalAlignment="Center">
                                        <Button x:Name="btnRefresh" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="BtnRefresh_Click" Cursor="Hand">
                                            <TextBlock Text="🔄" Foreground="#00E5FF" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="btnFavorite" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="BtnFavorite_Click" Cursor="Hand">
                                            <TextBlock Text="⭐" Foreground="#FFD700" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="toggleGameMode" Content="{DynamicResource CheckGameMode}" Foreground="#8E9AAF" FontSize="13" Margin="0,20,0,0" Checked="ToggleGameMode_Changed" Unchecked="ToggleGameMode_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
                        <Button x:Name="btnConnectSystem" Width="240" Height="70" Click="BtnConnectSystem_Click" Background="#00E5FF" Foreground="#121420" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnSysText" Text="{DynamicResource BtnConnectAction}" FontWeight="Black" FontSize="16"/>
                        </Button>
                        <TextBlock Text="{DynamicResource FooterConnInfo}" Foreground="#8E9AAF" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Nitro -->
                <Grid x:Name="paneNitro" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource TitleNitro}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="İnternet engellerini aşar. Sadece seçtiğiniz uygulamaları hızlandırır." Foreground="#8E9AAF" FontSize="14" Margin="0,0,0,25"/>

                        <Border Background="#242745" CornerRadius="12" Padding="15" Margin="0,0,0,15" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Nitro Hızlandırılacak Uygulamalar" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox x:Name="lstNitroApps" Grid.Row="1" Background="#1A1C2E" Height="220" SelectionMode="Extended"/>
                                
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnRemoveNitroApp" Content="{DynamicResource BtnRemoveSelected}" Width="120" Height="30" Background="#242745" BorderBrush="#3D3F5A" BorderThickness="1" Foreground="#DC3545" Margin="0,0,10,0" Click="BtnRemoveNitroApp_Click" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnBrowseNitroApp" Content="{DynamicResource BtnAddApp}" Width="120" Height="30" Background="#242745" BorderBrush="#3D3F5A" BorderThickness="1" Foreground="White" Click="BtnBrowseNitroApp_Click" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
                        <Button x:Name="btnConnectNitro" Width="240" Height="70" Click="BtnConnectNitro_Click" Background="#6F42C1" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnNitroText" Text="{DynamicResource BtnNitroStart}" FontWeight="Black" FontSize="16"/>
                        </Button>
                        <TextBlock Text="Discord ve yasaklı sitelerde kesintisiz hız sağlar." Foreground="#8E9AAF" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Apps -->
                <Grid x:Name="paneApps" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource TitleAppConn}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource DescAppConn}" Foreground="#8E9AAF" FontSize="14" Margin="0,0,0,25"/>

                        <Border Background="#242745" CornerRadius="12" Padding="15" Margin="0,0,0,15" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource HeaderAppList}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox x:Name="lstApps" Grid.Row="1" Background="#1A1C2E" Height="220" SelectionMode="Extended" KeyDown="LstApps_KeyDown"/>
                                
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Button x:Name="btnClearApps" Content="{DynamicResource BtnClearList}" HorizontalAlignment="Left" Background="Transparent" Foreground="#DC3545" BorderThickness="0" Cursor="Hand" Click="BtnClearApps_Click"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnRemoveApp" Content="{DynamicResource BtnRemoveSelected}" Width="120" Height="30" Background="#242745" BorderBrush="#3D3F5A" BorderThickness="1" Foreground="#DC3545" Margin="0,0,10,0" Click="BtnRemoveApp_Click" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnBrowseApp" Content="{DynamicResource BtnAddApp}" Width="120" Height="30" Background="#242745" BorderBrush="#3D3F5A" BorderThickness="1" Foreground="White" Click="BtnBrowseApp_Click" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="#242745" CornerRadius="12" Padding="15,15,15,20" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource HeaderAppServer}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cmbServersApps" DisplayMemberPath="DisplayName" Height="42" SelectionChanged="CmbServersApps_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
                        <Button x:Name="btnConnectApp" Width="240" Height="70" Click="BtnConnectApp_Click" Background="#00D2FF" Foreground="#121420" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnAppText" Text="{DynamicResource BtnConnectAppAction}" FontWeight="Black" FontSize="16"/>
                        </Button>
                        <TextBlock Text="{DynamicResource FooterAppInfo}" Foreground="#8E9AAF" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Safety -->
                <Grid x:Name="paneSafety" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TitleSafety}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource DescSafety}" Foreground="#8E9AAF" FontSize="14" Margin="0,0,0,30"/>

                        <Border Background="#242745" CornerRadius="12" Padding="30" ClipToBounds="True" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel>
                                <CheckBox x:Name="toggleSpoofing" Content="{DynamicResource CheckToggleSpoofing}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Checked="ToggleSpoofing_Changed" Unchecked="ToggleSpoofing_Changed"/>
                                <TextBlock Text="{DynamicResource HeaderSpoofRegion}" Foreground="#00E5FF" FontSize="13" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cmbSpoofingCountry" DisplayMemberPath="DisplayName" Height="45"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Section: GameMode -->
                <Grid x:Name="paneGame" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OYUN MODU" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Oyunlara yüksek hızla erişmenizi sağlar" Foreground="#8E9AAF" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
                        <Button x:Name="btnConnectGame" Width="240" Height="70" Click="BtnConnectGame_Click" Background="#FF3D00" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style></Button.Resources>
                            <TextBlock x:Name="txtBtnGameText" Text="OYUN MODUNU BAŞLAT" FontWeight="Black" FontSize="16"/>
                        </Button>
                        <TextBlock Text="VPN kapalıyken bile çalışır." Foreground="#8E9AAF" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Status Area (Persistent) -->
            <Border Grid.Row="2" Background="#121420" BorderBrush="#3D3F5A" BorderThickness="0,1,0,0" Padding="25,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource LabelVpnStatus}" Foreground="#8E9AAF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="lblSessionInfo" Text="{DynamicResource LockSessionInfo}" Foreground="#FFC107" FontSize="9" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtSessionRemaining" Text="03:00:00" Foreground="White" FontSize="10" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="txtStatus" Text="{DynamicResource StatusSelectServer}" Foreground="#00E5FF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBox x:Name="txtAddCode" Width="100" Height="38" Background="#1A1C2E" Foreground="#00E5FF" BorderBrush="#3D3F5A" BorderThickness="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,10,0" Padding="5" FontSize="14" FontWeight="Bold" MaxLength="6" ToolTip="Uzatma Kodu Girmek İçin"/>
                        <Button x:Name="btnAddTime" Content="+3 Saat Uzat" Background="#242745" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#3D3F5A" Padding="15,0" Height="38" FontWeight="Bold" Cursor="Hand" Click="BtnAddTime_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#242745" CornerRadius="8" Padding="15,8" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTimer" Text="00:00:00" Foreground="White" FontFamily="Consolas" FontSize="18"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Section: Lock Overlay (Covers all rows) -->
            <Grid x:Name="lockOverlay" Grid.RowSpan="3" Visibility="Visible" Panel.ZIndex="1000">
                <Border Background="#1A1C2E" Opacity="0.95"/>
                <Border Background="#242745" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="450" Padding="40" BorderBrush="#3D3F5A" BorderThickness="1">
                    <StackPanel>
                        <Image Source="Assets/logo.png" Width="80" Height="80" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource LockTitle}" Foreground="#00E5FF" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource LockDesc}" Foreground="#8E9AAF" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                        
                        <Border Background="#121420" CornerRadius="10" BorderBrush="#3D3F5A" BorderThickness="1" Margin="0,0,0,20">
                            <TextBox x:Name="txtAccessCode" Height="60" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="32" FontWeight="Bold" 
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="6"
                                     GotFocus="TxtAccessCode_GotFocus" />
                        </Border>

                        <Button x:Name="btnUnlock" Content="{DynamicResource LockBtnUnlock}" Height="55" Background="#00E5FF" Foreground="#121420" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" Click="BtnUnlock_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="btnGetCode" Content="{DynamicResource LockBtnGetCode}" Height="45" Background="Transparent" Foreground="#8E9AAF" BorderBrush="#3D3F5A" BorderThickness="1" FontSize="13" Click="BtnGetCode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                        
                        <TextBlock x:Name="txtLockStatus" Text="" Foreground="#DC3545" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Section: Update Overlay (En üst katman) -->
            <Grid x:Name="updateOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="1100">
                <Border Background="#1A1C2E" Opacity="0.98"/>
                <Border Background="#242745" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Padding="40" BorderBrush="#3D3F5A" BorderThickness="1">
                    <StackPanel>
                        <Image Source="Assets/logo.png" Width="70" Height="70" Margin="0,0,0,15"/>
                        <TextBlock Text="TRUVA GÜNCELLEME" Foreground="#00E5FF" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="txtUpdateVersion" Text="" Foreground="#8E9AAF" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Progress Bar -->
                        <Border Background="#121420" CornerRadius="6" Height="12" Margin="0,0,0,8" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="updateProgressFill" Background="#00E5FF" CornerRadius="6" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="txtUpdateStatus" Text="Güncelleme kontrol ediliyor..." Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="txtUpdatePercent" Text="" Foreground="#8E9AAF" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock x:Name="txtReleaseNotes" Text="" Foreground="#8E9AAF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" Visibility="Collapsed"/>

                        <Button x:Name="btnSkipUpdate" Content="Atla (Çevrimdışı)" Height="40" Background="Transparent" Foreground="#8E9AAF" BorderBrush="#3D3F5A" BorderThickness="1" FontSize="12" Cursor="Hand" Click="BtnSkipUpdate_Click" Visibility="Collapsed">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
